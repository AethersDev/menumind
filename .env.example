# Copy to .env, fill in, then load before starting the server:
#   set -a; source .env; set +a
# Model provider: openai (default) or anthropic. Only that provider's key is needed.
LLM_PROVIDER=openai
# Keep the key out of this file. On macOS, export it from the Keychain instead:
#   export OPENAI_API_KEY="$(security find-generic-password -s openai-api-key -w)"
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional model overrides; defaults per provider are in llm.py
# EXTRACT_MODEL=
# REPLY_MODEL=
DB_PATH=data/menumind.db
# Set to 1 when served over HTTPS
COOKIE_SECURE=0
